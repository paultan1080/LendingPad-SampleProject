											"pm.test(\"200 OK: only hardware priced 1 to 1000, including the mouse but not the laptop\", function () {",
											"    pm.response.to.have.status(200);",
											"    var products = pm.response.json();",
											"    var ids = products.map(function (p) { return p.id; });",
											"    pm.expect(ids).to.include(pm.collectionVariables.get(\"mouseId\"));",
											"    pm.expect(ids).to.not.include(pm.collectionVariables.get(\"laptopId\"));",
											"    products.forEach(function (p) {",
											"        pm.expect(p.category.key).to.eql(\"Hardware\");",
											"        pm.expect(p.price).to.be.within(1, 1000);",
